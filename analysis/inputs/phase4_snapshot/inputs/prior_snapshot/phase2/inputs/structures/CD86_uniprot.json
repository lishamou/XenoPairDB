{"entryType":"UniProtKB unreviewed (TrEMBL)","primaryAccession":"K7GMU1","secondaryAccessions":["A0A4X1TBF3"],"uniProtkbId":"K7GMU1_PIG","entryAudit":{"firstPublicDate":"2013-01-09","lastAnnotationUpdateDate":"2026-09-02","lastSequenceUpdateDate":"2017-11-22","entryVersion":96,"sequenceVersion":2},"annotationScore":3.0,"organism":{"scientificName":"Sus scrofa","commonName":"Pig","taxonId":9823,"evidences":[{"evidenceCode":"ECO:0000313","source":"Ensembl","id":"ENSSSCP00000028828.2"},{"evidenceCode":"ECO:0000313","source":"Proteomes","id":"UP000008227"}],"lineage":["Eukaryota","Metazoa","Chordata","Craniata","Vertebrata","Euteleostomi","Mammalia","Eutheria","Laurasiatheria","Artiodactyla","Suina","Suidae","Sus"]},"proteinExistence":"4: Predicted","proteinDescription":{"recommendedName":{"fullName":{"evidences":[{"evidenceCode":"ECO:0000256","source":"ARBA","id":"ARBA00074065"}],"value":"T-lymphocyte activation antigen CD86"}},"alternativeNames":[{"fullName":{"evidences":[{"evidenceCode":"ECO:0000256","source":"ARBA","id":"ARBA00078929"}],"value":"Activation B7-2 antigen"}}]},"genes":[{"geneName":{"evidences":[{"evidenceCode":"ECO:0000313","source":"Ensembl","id":"ENSSSCP00000028828.2"}],"value":"CD86"}}],"comments":[{"texts":[{"evidences":[{"evidenceCode":"ECO:0000256","source":"ARBA","id":"ARBA00094340"}],"value":"Costimulatory molecule that belongs to the immunoglobulin superfamily that plays an important role in T-lymphocyte activation. Acts as the primary auxiliary signal augmenting the MHC/TCR signal in naive T-cells by acting as a ligand for the CD28 receptor which is constitutively expressed on the cell surface of T-cells. May play a critical role in the early events of T-cell activation and costimulation of naive T-cells, such as deciding between immunity and anergy that is made by T-cells within 24 hours after activation. Also involved in the regulation of B cells function, plays a role in regulating the level of IgG(1) produced. Upon CD40 engagement, activates NF-kappa-B signaling pathway via phospholipase C and protein kinase C activation. Also acts as an inhibitor of T-cell activation by acting as a ligand for CTLA4, a decoy receptor, thereby blocking CD28-mediated T-cell priming"}],"commentType":"FUNCTION"},{"texts":[{"evidences":[{"evidenceCode":"ECO:0000256","source":"ARBA","id":"ARBA00094702"}],"value":"Homodimer. Interacts with MARCH8. Interacts (via cytoplasmic domain) with PHB1 and PHB2; the interactions increases after priming with CD40"}],"commentType":"SUBUNIT"},{"commentType":"SUBCELLULAR LOCATION","subcellularLocations":[{"location":{"evidences":[{"evidenceCode":"ECO:0000256","source":"ARBA","id":"ARBA00004251"}],"value":"Cell membrane","id":"SL-0039"},"topology":{"evidences":[{"evidenceCode":"ECO:0000256","source":"ARBA","id":"ARBA00004251"}],"value":"Single-pass type I membrane protein","id":"SL-9905"}}]},{"texts":[{"evidences":[{"evidenceCode":"ECO:0000256","source":"PROSITE-ProRule","id":"PRU00114"}],"value":"Lacks conserved residue(s) required for the propagation of feature annotation"}],"commentType":"CAUTION"}],"features":[{"type":"Transmembrane","location":{"start":{"value":255,"modifier":"EXACT"},"end":{"value":277,"modifier":"EXACT"}},"description":"Helical","evidences":[{"evidenceCode":"ECO:0000256","source":"SAM","id":"Phobius"}]},{"type":"Domain","location":{"start":{"value":39,"modifier":"EXACT"},"end":{"value":133,"modifier":"EXACT"}},"description":"Ig-like","evidences":[{"evidenceCode":"ECO:0000259","source":"PROSITE","id":"PS50835"}]},{"type":"Region","location":{"start":{"value":282,"modifier":"EXACT"},"end":{"value":317,"modifier":"EXACT"}},"description":"Disordered","evidences":[{"evidenceCode":"ECO:0000256","source":"SAM","id":"MobiDB-lite"}]},{"type":"Compositional bias","location":{"start":{"value":300,"modifier":"EXACT"},"end":{"value":317,"modifier":"EXACT"}},"description":"Basic and acidic residues","evidences":[{"evidenceCode":"ECO:0000256","source":"SAM","id":"MobiDB-lite"}]}]